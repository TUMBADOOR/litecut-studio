{
  "name": "litecut-studio",
  "productName": "LiteCut Studio",
  "version": "1.0.0",
  "description": "Editor de video liviano con grabador de pantalla para Windows y macOS",
  "main": "src/main/main.js",
  "type": "module",
  "author": "LiteCut Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "fonts": "node scripts/copy-fonts.js",
    "test": "node scripts/test-ops.js && node scripts/test-export.js",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac -c.mac.identity=- --publish never",
    "dist:mac-arm64": "electron-builder --mac --arm64 -c.mac.identity=- --publish never",
    "dist:mac-x64": "electron-builder --mac --x64 -c.mac.identity=- --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.0.0",
    "@fontsource/bangers": "^5.0.0",
    "@fontsource/bebas-neue": "^5.0.0",
    "@fontsource/caveat": "^5.0.0",
    "@fontsource/dancing-script": "^5.0.0",
    "@fontsource/lobster": "^5.0.0",
    "@fontsource/montserrat": "^5.0.0",
    "@fontsource/oswald": "^5.0.0",
    "@fontsource/pacifico": "^5.0.0",
    "@fontsource/permanent-marker": "^5.0.0",
    "@fontsource/playfair-display": "^5.0.0",
    "@fontsource/poppins": "^5.0.0",
    "electron": "44.9.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.litecut.studio",
    "productName": "LiteCut Studio",
    "copyright": "LiteCut Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ],
    "fileAssociations": [
      {
        "ext": "lcproj",
        "name": "Proyecto LiteCut",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LiteCut Studio",
      "artifactName": "LiteCut-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "LiteCut-Studio-Portable-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "LiteCut Studio usa la cámara para grabar tu webcam junto con la pantalla.",
        "NSMicrophoneUsageDescription": "LiteCut Studio usa el micrófono para grabar tu voz.",
        "NSScreenCaptureUsageDescription": "LiteCut Studio necesita grabar la pantalla para el grabador de pantalla."
      },
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "artifactName": "LiteCut-Studio-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "LiteCut Studio ${version}"
    }
  }
}
